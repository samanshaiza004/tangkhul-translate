# Copy to .env and fill in. Never commit .env.

# Supabase Postgres.
# Local dev on macOS: use the Supavisor SESSION pooler (port 5432, IPv4).
# The direct connection (db.<ref>.supabase.co:5432) is IPv6-only and will time out.
# Never use the transaction pooler (port 6543): it breaks prepared statements.
DATABASE_URL=postgresql://postgres.gblybekxtsbiciuzqhmu:YOUR_PASSWORD@aws-0-us-east-2.pooler.supabase.com:5432/postgres

PORT=3000
NODE_ENV=development

# Disposable Postgres for `bun run db:verify-fresh`. Must NOT be a Supabase host.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/postgres?sslmode=disable

# Hugging Face Space used only by the Bun server. The frontend-demo copy is
# currently public, so HF_TOKEN is optional. Add a read token if the copy is
# changed to private; protected/public running apps remain publicly callable.
HF_SPACE=chormi/byt5-tang-eng-frontend-demo
# HF_TOKEN=hf_your_read_token
HF_TIMEOUT_MS=180000

# Maintainer-only review/export identity.
# REVIEWER_ID=saman
